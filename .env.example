# Copie para .env (fica fora do git) e preencha.
# Login do Kibana — o mesmo para todos os clientes.
KIBANA_USER=
KIBANA_PASS=

# Índice dos logs dos containers (gelf → logstash).
KIBANA_INDEX=dockers-*

# 1 = aceita certificado inválido/autoassinado (só se algum cliente precisar).
KIBANA_INSECURE=0

PORT=4600

# Interface onde escuta: 127.0.0.1 (só esta máquina) ou 0.0.0.0 (rede / container).
HOST=127.0.0.1

# Só consulta (e só manda o login para) estes hosts. Vírgula; "*.dominio" vale para subdomínios.
ALLOWED_HOSTS=*.weon.com.br
